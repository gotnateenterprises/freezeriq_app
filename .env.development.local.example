# DEV-ENV-SAFETY-1 — template for .env.development.local
#
# Copy this file to `.env.development.local` (gitignored, never committed)
# and fill in your own local values. Next.js gives this file the HIGHEST
# precedence for `next dev` — .env.development.local > .env.local >
# .env.development > .env — so it is what stops `.env.local` (which in
# this repo holds Production credentials) from being resolved by an
# ordinary local dev server.
#
# See docs/DEV_ENVIRONMENT_SAFETY.md for the full explanation.

# Local Postgres. Match whatever your own local database is actually
# called/authenticated as — these are placeholders, not real credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/freezer_iq?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/freezer_iq?schema=public

# Deliberately left BLANK. lib/s3.ts falls back to writing uploaded files
# under public/uploads/ on disk whenever S3_BUCKET_NAME is unset — that is
# the genuinely local storage path. There is no separate "dev" S3/R2
# bucket in this project: every populated S3_* value in .env, .env.local,
# and .env.production currently points at the SAME real bucket, so setting
# any of these here would defeat the point of this file.
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_DOMAIN=
