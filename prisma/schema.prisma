// ── FR-RETENTION-3 · Email preview, controlled send, delivery tracking ──────
// Appended at end-of-file; the parked PasswordResetToken hunk above is untouched.
//
// STATUS HONESTY — the single most important rule in this block:
// The provider is Resend. `resend.emails.send()` returning an id proves the
// provider ACCEPTED the message. It does NOT prove delivery. There is no
// Resend webhook handler in this repository, so nothing here may claim
// `delivered`, `opened`, `clicked`, or `bounced`. EmailProviderEvent exists as
// the foundation for that, and is deliberately left un-ingested rather than
// populated with invented events.

model OutreachMessage {
  id                 String   @id @default(uuid())
  business_id        String
  outreach_batch_id  String
  subject            String
  html_body          String
  text_body          String
  // Bumped when the tenant edits and re-approves, so a later send can prove
  // which wording was actually approved.
  version            Int      @default(1)
  status             OutreachMessageStatus @default(draft)
  created_by_user_id String?
  approved_at        DateTime?
  // Only ever set from real send activity — never speculatively.
  send_started_at    DateTime?
  send_completed_at  DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  business           Business      @relation("BusinessOutreachMessages", fields: [business_id], references: [id], onDelete: Cascade)
  batch              OutreachBatch @relation("BatchMessages", fields: [business_id, outreach_batch_id], references: [business_id, id], onDelete: Cascade)
  attempts           EmailDeliveryAttempt[] @relation("MessageAttempts")

  // One current message per audience in this checkpoint.
  @@unique([outreach_batch_id])
  @@unique([business_id, id])
  @@map("outreach_messages")
}

// One send attempt for one delivery address. THE duplicate-prevention record:
// a partial unique index on (message, recipient) WHERE NOT is_test guarantees
// one real provider call per recipient per message, however many times Send is
// clicked.
model EmailDeliveryAttempt {
  id                  String   @id @default(uuid())
  business_id         String
  outreach_batch_id   String
  outreach_recipient_id String
  outreach_message_id String
  // Stable, deterministic claim key: message + recipient + generation.
  idempotency_key     String
  attempt_number      Int      @default(1)
  status              DeliveryAttemptStatus @default(queued)
  // Resend's message id. Proves ACCEPTANCE, not delivery.
  provider_message_id String?
  accepted_at         DateTime?
  failed_at           DateTime?
  skipped_at          DateTime?
  failure_category    DeliveryFailureCategory?
  // Sanitized, tenant-safe. Never a raw provider stack trace.
  failure_detail      String?
  // Test traffic is recorded separately so it can never be mistaken for a real
  // coordinator delivery.
  is_test             Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  business            Business          @relation("BusinessDeliveryAttempts", fields: [business_id], references: [id], onDelete: Cascade)
  message             OutreachMessage   @relation("MessageAttempts", fields: [business_id, outreach_message_id], references: [business_id, id], onDelete: Cascade)
  recipient           OutreachRecipient @relation("RecipientAttempts", fields: [business_id, outreach_recipient_id], references: [business_id, id], onDelete: Restrict)
  events              EmailProviderEvent[] @relation("AttemptEvents")

  // NOTE: a second guarantee lives in raw SQL as a PARTIAL unique index
  // (email_delivery_attempts_one_live_per_recipient) on
  // (outreach_message_id, outreach_recipient_id) WHERE NOT is_test AND
  // status <> 'failed'. Queued/accepted/skipped block a duplicate send; failed
  // rows stay retryable. Not expressible as a Prisma @@unique.
  @@unique([idempotency_key])
  @@unique([business_id, id])
  @@index([business_id, outreach_batch_id, status])
  @@map("email_delivery_attempts")
}

// Append-only provider event history. FOUNDATION ONLY in Checkpoint 3: no
// webhook route exists, so no row is written here yet. Rows are never updated
// or deleted.
model EmailProviderEvent {
  id                  String   @id @default(uuid())
  business_id         String
  delivery_attempt_id String
  // Provider's own event id, when the provider supplies one. Unique so replayed
  // webhook deliveries cannot double-record the same event.
  provider_event_id   String?
  event_type          ProviderEventType
  occurred_at         DateTime?
  received_at         DateTime @default(now())
  // Minimal sanitized payload for audit/debugging. Never raw provider secrets,
  // never unnecessary PII.
  metadata            Json?
  created_at          DateTime @default(now())

  business            Business             @relation("BusinessProviderEvents", fields: [business_id], references: [id], onDelete: Cascade)
  attempt             EmailDeliveryAttempt @relation("AttemptEvents", fields: [business_id, delivery_attempt_id], references: [business_id, id], onDelete: Cascade)

  @@index([business_id, delivery_attempt_id])
  @@map("email_provider_events")
}

enum OutreachMessageStatus {
  draft
  approved
  sending
  sent
  sent_with_issues
  failed
}

enum DeliveryAttemptStatus {
  queued
  // The provider accepted the message. This is the honest ceiling without
  // delivery webhooks — it is NOT proof of delivery.
  accepted
  failed
  // Suppressed between audience review and send.
  skipped_suppressed
}

enum DeliveryFailureCategory {
  provider_rejected_recipient
  provider_auth
  transient_transport
  invalid_address
  unknown
}

enum ProviderEventType {
  delivered
  bounced
  complained
  deferred
}


// ── FR-RETENTION-4 · Rebooking response, revisions, opportunities ───────────
// Appended at end-of-file; the parked PasswordResetToken hunk above is untouched.
//
// THE SHAPE OF THIS, because it is easy to get wrong:
//   Submission  = one durable response THREAD per delivery recipient.
//   Revision    = an immutable snapshot of one deliberate submit. Never updated.
//   RevisionOrg = the state of EVERY represented organization at that revision,
//                 including the ones NOT selected — that is what makes a later
//                 deselection legible instead of a silent disappearance.
//   Opportunity = one durable, reopenable record per (season, organization).
//
// One organization becomes at most one future fundraiser. Selecting three
// organizations creates three opportunities, never one merged booking.
//
// Every index below carries an explicit `map:` so the name in this schema and
// the name in the hand-authored migration are the same string by construction,
// rather than by hoping Prisma's default naming agrees.

model RebookingSubmission {
  id                    String   @id @default(uuid())
  business_id           String
  seasonal_offering_id  String
  outreach_recipient_id String
  // Mirrors the highest revision number. The revisions themselves remain the
  // source of truth; this exists so a list query does not need an aggregate.
  current_revision      Int      @default(0)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  business              Business          @relation("BusinessRebookingSubmissions", fields: [business_id], references: [id], onDelete: Cascade)
  recipient             OutreachRecipient @relation("RecipientSubmissions", fields: [business_id, outreach_recipient_id], references: [business_id, id], onDelete: Cascade, map: "rebooking_submissions_recipient_fkey")
  revisions             RebookingSubmissionRevision[] @relation("SubmissionRevisions")
  opportunities         RebookingOpportunity[]        @relation("SubmissionOpportunities")

  // One response thread per delivery recipient — editing appends a revision
  // rather than starting a second thread. Also the concurrency guarantee: two
  // simultaneous first-submits cannot both create a thread.
  @@unique([outreach_recipient_id], map: "rebooking_submissions_outreach_recipient_id_key")
  @@unique([business_id, id], map: "rebooking_submissions_business_id_id_key")
  @@index([business_id, seasonal_offering_id], map: "rebooking_submissions_business_offering_idx")
  @@map("rebooking_submissions")
}

// IMMUTABLE. Nothing in the application updates a revision after creation; a
// changed answer becomes revision N+1. That is what lets the tenant see what was
// said first and what changed, rather than only the latest state.
//
// NOTE: three CHECK constraints live in raw SQL and are not expressible here —
// revision_number >= 1, participant_estimate >= 0, and preferred_end_date >=
// preferred_start_date.
model RebookingSubmissionRevision {
  id                       String   @id @default(uuid())
  business_id              String
  submission_id            String
  revision_number          Int
  // Response evidence, NOT authority to rewrite CRM identity. A respondent
  // correcting their own name here never overwrites a FundraiserContact.
  respondent_name          String?
  respondent_email         String?
  respondent_phone         String?
  // Shared timing — the prototype asks once, and the tenant confirms each
  // organization separately afterwards.
  preferred_start_date     DateTime?
  alternate_start_date     DateTime?
  preferred_end_date       DateTime?
  participant_estimate     Int?
  notes                    String?
  // Set when the respondent edited their contact details, so the tenant can
  // reconcile deliberately instead of it happening silently behind them.
  contact_update_requested Boolean  @default(false)
  // Deterministic claim key, so a double-submitted form cannot become two
  // revisions.
  idempotency_key          String
  created_at               DateTime @default(now())

  submission               RebookingSubmission @relation("SubmissionRevisions", fields: [business_id, submission_id], references: [business_id, id], onDelete: Cascade, map: "rebooking_submission_revisions_submission_fkey")
  orgs                     RebookingSubmissionRevisionOrg[] @relation("RevisionOrgs")
  opportunities            RebookingOpportunity[]           @relation("RevisionOpportunities")

  @@unique([submission_id, revision_number], map: "rebooking_submission_revisions_submission_number_key")
  @@unique([idempotency_key], map: "rebooking_submission_revisions_idempotency_key")
  @@unique([business_id, id], map: "rebooking_submission_revisions_business_id_id_key")
  @@map("rebooking_submission_revisions")
}

// One row per REPRESENTED organization per revision — SELECTED OR NOT. Keeping
// the unselected ones is what lets the tenant read "Cedar Ridge sat this season
// out" instead of watching a row quietly vanish between revisions.
model RebookingSubmissionRevisionOrg {
  id                 String   @id @default(uuid())
  business_id        String
  revision_id        String
  customer_id        String
  // Denormalized on purpose: what the organization was CALLED at the moment of
  // the response. A later rename in the CRM must not rewrite history.
  organization_name  String
  selected           Boolean  @default(false)
  coordinator_intent CoordinatorIntent @default(not_sure)
  // Captured when the respondent says someone else will coordinate. EVIDENCE
  // ONLY — it grants no portal access and creates no CampaignContact.
  coordinator_name   String?
  coordinator_email  String?
  org_notes          String?
  created_at         DateTime @default(now())

  revision           RebookingSubmissionRevision @relation("RevisionOrgs", fields: [business_id, revision_id], references: [business_id, id], onDelete: Cascade, map: "rebooking_submission_revision_orgs_revision_fkey")
  customer           Customer                    @relation("OrgRevisionSnapshots", fields: [business_id, customer_id], references: [business_id, id], onDelete: Restrict, map: "rebooking_submission_revision_orgs_customer_fkey")

  @@unique([revision_id, customer_id], map: "rebooking_submission_revision_orgs_revision_customer_key")
  @@index([business_id, customer_id], map: "rebooking_submission_revision_orgs_business_customer_idx")
  @@map("rebooking_submission_revision_orgs")
}

// One durable, REOPENABLE record per (season, organization). Deselecting cancels
// it; reselecting reopens THIS row rather than creating a second one.
//
// NOTE: two CHECK constraints live in raw SQL — participant_estimate >= 0, and a
// canceled/canceled_at consistency check that stops the list from claiming a
// cancellation it cannot date.
model RebookingOpportunity {
  id                    String   @id @default(uuid())
  business_id           String
  seasonal_offering_id  String
  customer_id           String
  outreach_recipient_id String
  submission_id         String
  source_revision_id    String
  organization_name     String
  status                RebookingOpportunityStatus @default(interested)
  coordinator_intent    CoordinatorIntent          @default(not_sure)
  coordinator_name      String?
  coordinator_email     String?
  preferred_start_date  DateTime?
  alternate_start_date  DateTime?
  participant_estimate  Int?
  notes                 String?
  // Checkpoint 5 conversion target. Checkpoint 4 never creates a campaign, so
  // this stays null and deliberately carries no foreign key yet.
  campaign_id           String?
  canceled_at           DateTime?
  reopened_at           DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  business              Business                    @relation("BusinessRebookingOpportunities", fields: [business_id], references: [id], onDelete: Cascade)
  offering              SeasonalOffering            @relation("OfferingOpportunities", fields: [business_id, seasonal_offering_id], references: [business_id, id], onDelete: Restrict, map: "rebooking_opportunities_offering_fkey")
  customer              Customer                    @relation("OrgOpportunities", fields: [business_id, customer_id], references: [business_id, id], onDelete: Restrict, map: "rebooking_opportunities_customer_fkey")
  recipient             OutreachRecipient           @relation("RecipientOpportunities", fields: [business_id, outreach_recipient_id], references: [business_id, id], onDelete: Restrict, map: "rebooking_opportunities_recipient_fkey")
  submission            RebookingSubmission         @relation("SubmissionOpportunities", fields: [business_id, submission_id], references: [business_id, id], onDelete: Cascade, map: "rebooking_opportunities_submission_fkey")
  source_revision       RebookingSubmissionRevision @relation("RevisionOpportunities", fields: [business_id, source_revision_id], references: [business_id, id], onDelete: Restrict, map: "rebooking_opportunities_source_revision_fkey")

  // ONE organization = ONE future fundraiser per season. This is the constraint
  // that makes reselection REOPEN rather than duplicate, even when two submits
  // race. Intentionally not partial: a canceled opportunity still holds the
  // slot, because reopening it is correct and creating a twin is not.
  @@unique([business_id, seasonal_offering_id, customer_id], map: "rebooking_opportunities_one_per_org_per_season")
  @@unique([business_id, id], map: "rebooking_opportunities_business_id_id_key")
  @@index([business_id, status], map: "rebooking_opportunities_business_status_idx")
  @@map("rebooking_opportunities")
}

// `not_sure` is a real answer, not an absence of one. A respondent who does not
// yet know who will coordinate must be able to say so without being pushed into
// a wrong yes or no.
enum CoordinatorIntent {
  yes
  no
  not_sure
}

enum RebookingOpportunityStatus {
  // The respondent asked for it; the tenant has not decided yet.
  interested
  // The tenant said yes. Ready for a fundraiser to be created in Checkpoint 5.
  approved
  // The respondent CHANGED something the tenant had already approved. Surfaced
  // rather than silently overwritten — a moved date the tenant never sees is
  // exactly the failure this status exists to prevent.
  needs_review
  // Deselected by the respondent, or "Not this season" by the tenant.
  canceled
  // A fundraiser exists. Nothing in Checkpoint 4 ever sets this.
  converted
}

// ── GE-5A · Safe automation foundation ──────────────────────────────────────
// A recommendation engine that can propose work and nothing else. GE-5A writes
// only to the two tables below; every FR-RETENTION table is read-only to it, so
// no path here can send, schedule, or queue an email. Execution — turning an
// approved recommendation into a real OutreachBatch — belongs to GE-7, which is
// why there is no `executed` status and no outreach_batch_id yet: this phase
// cannot reach that state, so claiming it in the schema would be a lie.

enum AutomationActionType {
  // The only action family GE-5A ships. A new family is a deliberate decision,
  // not a string someone passes in.
  seasonal_rebooking_recommendation
}

enum AutomationActionStatus {
  candidate
  approved
  dismissed
  suppressed
  expired
}

/// Per-tenant switch for one action family. Absence of a row means OFF, and so
/// does `enabled = false`; nothing creates this row implicitly, so a tenant that
/// has never opted in cannot have recommendations generated for them.
model AutomationPolicy {
  id                 String               @id @default(uuid())
  business_id        String
  action_type        AutomationActionType
  enabled            Boolean              @default(false)
  // Repo convention for actor attribution: an unenforced nullable id. `User`
  // has no [business_id, id] unique to point a compound FK at, and its
  // business_id is nullable for super-admins, so the existing FR-RETENTION
  // columns (created_by_user_id, recorded_by_user_id) are plain strings too.
  updated_by_user_id String?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt

  business           Business             @relation("BusinessAutomationPolicies", fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([business_id, action_type])
  @@map("automation_policies")
}

/// One auditable recommendation. The unique tuple below IS the idempotency
/// contract: business + family + offering + organization identifies the action,
/// so re-evaluating the same condition can never create a second row, and a
/// dismissed or expired action is not silently replaced by a fresh one. A new
/// SeasonalOffering is what legitimately starts a new lifecycle.
model AutomationAction {
  id                   String                 @id @default(uuid())
  business_id          String
  action_type          AutomationActionType
  status               AutomationActionStatus @default(candidate)

  // Required, not optional. A nullable column inside the unique tuple would let
  // Postgres treat NULLs as distinct and quietly stop enforcing uniqueness.
  seasonal_offering_id String
  customer_id          String

  /// Transparent evidence. Every entry carries kind: 'fact' | 'heuristic' so a
  /// GE-3 threshold can never be presented as an observation.
  reasons              Json
  evidence_at          DateTime
  expires_at           DateTime?

  approved_by_user_id  String?
  approved_at          DateTime?
  dismissed_by_user_id String?
  dismissed_at         DateTime?
  suppressed_at        DateTime?
  suppressed_reason    String?
  expired_at           DateTime?
  /// Controlled value from AutomationExpiredReason in lib/growth/automation.ts,
  /// not tenant-authored text: a state-machine reason must stay machine-readable.
  expired_reason       String?

  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  business             Business               @relation("BusinessAutomationActions", fields: [business_id], references: [id], onDelete: Cascade)
  // Compound FKs carry business_id into the reference, so a row pointing at
  // another tenant's offering or organization is rejected by the database
  // rather than by a code path someone might forget to write.
  offering             SeasonalOffering       @relation("OfferingAutomationActions", fields: [business_id, seasonal_offering_id], references: [business_id, id], onDelete: Restrict, map: "automation_actions_offering_fkey")
  customer             Customer               @relation("OrgAutomationActions", fields: [business_id, customer_id], references: [business_id, id], onDelete: Restrict, map: "automation_actions_customer_fkey")

  @@unique([business_id, action_type, seasonal_offering_id, customer_id], map: "automation_actions_one_per_org_per_offering")
  @@index([business_id, status, action_type])
  @@index([business_id, seasonal_offering_id])
  @@map("automation_actions")
}
