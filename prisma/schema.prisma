// ── FR-RETENTION-2 · Seasonal Lineup and audience ───────────────────────────
// Appended at end-of-file so the parked PasswordResetToken hunk above is never
// touched. Tenant naming note: the model is SeasonalOffering, but ordinary
// tenant UI must always say "Seasonal Lineup".
//
// AUDIENCE MODEL — the important distinction:
//   CRM identity  : one FundraiserContact per durable PERSON. Never merged.
//   Audience      : one OutreachRecipient per DELIVERY ADDRESS.
// Two people sharing an inbox stay two contacts and become one recipient, with
// OutreachRecipientContact / OutreachRecipientOrg recording everyone the single
// email represents. Sharing an address never rewrites durable identity.

model SeasonalOffering {
  id                       String    @id @default(uuid())
  business_id              String
  name                     String
  starts_at                DateTime
  ends_at                  DateTime
  status                   SeasonalOfferingStatus @default(draft)
  coordinator_bundle_limit Int       @default(2)
  // "Advanced" fields from the approved prototype. Optional throughout.
  subject_override         String?
  sales_letter             String?
  internal_notes           String?
  // Nullable plain column, following the FundraiserCampaign.closed_by
  // precedent — deliberately not an FK so removing a user cannot block or
  // cascade into lineup history.
  created_by_user_id       String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  archived_at              DateTime?

  business                 Business  @relation("BusinessSeasonalOfferings", fields: [business_id], references: [id], onDelete: Cascade)
  families                 SeasonalOfferingFamily[] @relation("OfferingFamilies")
  outreach_batches         OutreachBatch[]          @relation("OfferingBatches")
  // FR-RETENTION-4
  opportunities            RebookingOpportunity[]   @relation("OfferingOpportunities")
  automation_actions       AutomationAction[]       @relation("OfferingAutomationActions")

  @@unique([business_id, id])
  @@index([business_id, status])
  @@map("seasonal_offerings")
}

// One selected bundle FAMILY on a lineup — family identity, never a raw SKU.
// family_id intentionally has NO foreign key: bundles.family_id is shared by
// the Serves-5 and Serves-2 siblings, so it is not unique in `bundles` and
// cannot be referenced. Eligibility is validated on write through the CB-4
// resolver (lib/campaignBundleSelection.resolveEligibleBundleFamilies).
model SeasonalOfferingFamily {
  id                   String   @id @default(uuid())
  business_id          String
  seasonal_offering_id String
  family_id            String
  position             Int      @default(0)
  created_at           DateTime @default(now())

  offering             SeasonalOffering @relation("OfferingFamilies", fields: [business_id, seasonal_offering_id], references: [business_id, id], onDelete: Cascade)

  @@unique([seasonal_offering_id, family_id])
  @@index([business_id, family_id])
  @@map("seasonal_offering_families")
}

// One audience workflow for one lineup. In Checkpoint 2 this is an audience
// SNAPSHOT only — nothing here asserts that a message was ever sent.
model OutreachBatch {
  id                    String    @id @default(uuid())
  business_id           String
  seasonal_offering_id  String
  status                OutreachBatchStatus @default(draft)
  audience_calculated_at DateTime?
  recipient_count       Int       @default(0)
  included_count        Int       @default(0)
  excluded_count        Int       @default(0)
  needs_review_count    Int       @default(0)
  created_by_user_id    String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  business              Business  @relation("BusinessOutreachBatches", fields: [business_id], references: [id], onDelete: Cascade)
  offering              SeasonalOffering @relation("OfferingBatches", fields: [business_id, seasonal_offering_id], references: [business_id, id], onDelete: Restrict)
  recipients            OutreachRecipient[] @relation("BatchRecipients")
  // FR-RETENTION-3
  messages              OutreachMessage[]   @relation("BatchMessages")

  // One audience per lineup — the double-click guarantee, enforced by the
  // database rather than trusted to the caller.
  @@unique([seasonal_offering_id])
  @@unique([business_id, id])
  @@index([business_id, status])
  @@map("outreach_batches")
}

// One DELIVERY ADDRESS in one audience. Snapshot-bearing: the display fields
// are frozen at calculation time so a later contact edit cannot silently
// rewrite an audience the tenant already reviewed.
model OutreachRecipient {
  id                        String   @id @default(uuid())
  business_id               String
  outreach_batch_id         String
  // Internal only. Never returned to tenant UI and never used as a
  // tenant-visible identifier.
  normalized_email          String?
  display_name              String
  email_masked              String?
  is_shared_inbox           Boolean  @default(false)
  represented_contact_count Int      @default(1)
  represented_org_count     Int      @default(0)
  represented_org_names     String[] @default([])
  eligibility               RecipientEligibility
  exclusion_reason          RecipientExclusionReason?
  exclusion_detail          String?
  excluded_until            DateTime?
  // Tenant may deselect an otherwise-included address before continuing.
  is_selected               Boolean  @default(true)
  snapshot_at               DateTime @default(now())
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  batch                     OutreachBatch @relation("BatchRecipients", fields: [business_id, outreach_batch_id], references: [business_id, id], onDelete: Cascade)
  contacts                  OutreachRecipientContact[] @relation("RecipientContacts")
  orgs                      OutreachRecipientOrg[]     @relation("RecipientOrgs")
  // FR-RETENTION-3
  attempts                  EmailDeliveryAttempt[]     @relation("RecipientAttempts")

  // ── FR-RETENTION-4 · secure rebooking credential ───────────────────────────
  // The credential belongs to the DELIVERY RECIPIENT, not to a person: one
  // inbox may represent several durable contacts and organizations, and we
  // cannot know which of them opened the email.
  //
  // Only the SHA-256 digest is stored. The raw token exists in memory just long
  // enough to be rendered into that one recipient's email, and is never
  // persisted, logged, or written into the message body we retain.
  //
  // The unique index is GLOBAL rather than tenant-scoped on purpose: the digest
  // is the lookup key on a public, unauthenticated route whose URL carries no
  // business identifier, so it has to be unambiguous across the whole table.
  rebooking_token_hash       String?   @unique(map: "outreach_recipients_rebooking_token_hash_key")
  rebooking_token_issued_at  DateTime?
  rebooking_token_expires_at DateTime?
  // Revoked and expired credentials are deliberately KEPT resolvable, so the
  // respondent gets an honest "this link expired" page instead of a bare 404.
  rebooking_token_revoked_at DateTime?
  // Set when a respondent asks for a fresh link from an expired page. Surfaces
  // as tenant "Needs action"; nothing sends automatically.
  refresh_requested_at       DateTime?
  submissions                RebookingSubmission[]      @relation("RecipientSubmissions")
  opportunities              RebookingOpportunity[]     @relation("RecipientOpportunities")

  // NOTE: two more FR-RETENTION-4 artifacts live in raw SQL and are not
  // expressible here — a partial index on (business_id, refresh_requested_at)
  // WHERE refresh_requested_at IS NOT NULL that keeps the tenant's "needs a
  // fresh link" queue cheap, and a CHECK that a credential cannot expire before
  // it was issued.

  // NOTE: the deduplication guarantee — one deliverable row per normalized
  // address per audience — is a PARTIAL unique index created in raw SQL
  // (outreach_recipients_batch_one_email, WHERE normalized_email IS NOT NULL).
  // It is partial so that several "no email" recipients may coexist, which a
  // Prisma @@unique cannot express.
  @@unique([business_id, id])
  @@index([business_id, outreach_batch_id, eligibility])
  @@map("outreach_recipients")
}

// Every durable person this one address reaches. Restrict: an address that
// carries audience history must not be able to erase the contact behind it.
model OutreachRecipientContact {
  id                    String   @id @default(uuid())
  business_id           String
  outreach_recipient_id String
  contact_id            String
  contact_display_name  String
  created_at            DateTime @default(now())

  recipient             OutreachRecipient @relation("RecipientContacts", fields: [business_id, outreach_recipient_id], references: [business_id, id], onDelete: Cascade)
  contact               FundraiserContact @relation("ContactOutreachLinks", fields: [business_id, contact_id], references: [business_id, id], onDelete: Restrict)

  @@unique([outreach_recipient_id, contact_id])
  @@index([business_id, contact_id])
  @@map("outreach_recipient_contacts")
}

// Every organization this one address represents.
model OutreachRecipientOrg {
  id                    String   @id @default(uuid())
  business_id           String
  outreach_recipient_id String
  customer_id           String
  organization_name     String
  created_at            DateTime @default(now())

  recipient             OutreachRecipient @relation("RecipientOrgs", fields: [business_id, outreach_recipient_id], references: [business_id, id], onDelete: Cascade)
  customer              Customer          @relation("OrgOutreachLinks", fields: [business_id, customer_id], references: [business_id, id], onDelete: Restrict)

  @@unique([outreach_recipient_id, customer_id])
  @@index([business_id, customer_id])
  @@map("outreach_recipient_orgs")
}

// Marketing preference. Two scopes, per the approved rule:
//   contact       — belongs to the PERSON and survives an email change.
//   email_address — belongs to the ADDRESS; suppresses everyone using it.
// Unsubscribing never deletes contact history, and never affects
